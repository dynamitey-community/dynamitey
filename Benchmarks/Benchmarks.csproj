<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>Dynamitey.Benchmarks</AssemblyName>
    <RootNamespace>Dynamitey.Benchmarks</RootNamespace>
    <!-- BenchmarkDotNet refuses to run a non-optimised build, and warns on any
         attached debugger. Always run this with -c Release. -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Tracks current FSharp.Core rather than a pinned old version. The tuple
         benchmarks compare Tupler against F# reflection, and the useful
         comparison is against the F# a consumer would actually have, not the
         4.7.2 the retired SpeedTest fixture happened to reference. -->
    <PackageReference Include="FSharp.Core" Version="10.1.400" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dynamitey\Dynamitey.csproj" />
    <ProjectReference Include="..\SupportLibrary\SupportLibrary.csproj" />
  </ItemGroup>

</Project>
