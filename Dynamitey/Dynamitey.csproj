<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <!-- netstandard2.0's default LangVersion (7.3, driven off the TFM) predates both
         nullable reference types (C# 8) and the `is not null` pattern (C# 9) used
         throughout the annotated code. `latest` matches what net10.0 already gets by
         default, so both legs of the multi-target compile the same syntax. -->
    <LangVersion>latest</LangVersion>
    <Description>(pronounced dyna-mighty) flexes DLR muscle to do meta-mazing things in .net. This package is a community continuation fork; it is not the original `Dynamitey` package published by Ekon Benefits.</Description>
    <Company>The dynamitey-community contributors</Company>
    <Authors>Ekon Benefits; The dynamitey-community contributors</Authors>
    <Copyright>Copyright 2010-2024 Ekon Benefits. Copyright 2026 The dynamitey-community contributors.</Copyright>
    <PackageProjectUrl>https://github.com/dynamitey-community/dynamitey</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dynamitey-community/dynamitey.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <PackageTags>dynamic metaprogramming dlr reflection currying tuples expando latetypes</PackageTags>
    <IncludeSymbols>True</IncludeSymbols>
    <IncludeSource>True</IncludeSource>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>sn.snk</AssemblyOriginatorKeyFile>
    <DelaySign>False</DelaySign>

  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0'">
    <!-- Surfaces IL2026/IL3050 (and friends) at build time for any dynamic-dispatch or
         reflection-by-name call this library's own code makes that isn't wrapped behind a
         [RequiresUnreferencedCode]/[RequiresDynamicCode]-annotated member - see issue #4.
         Deliberately NOT IsTrimmable or IsAotCompatible: those claim the assembly is safe to
         trim/AOT-compile, which it is not and never will be (it's built on the DLR). This pair
         only turns on the diagnostics; it makes no claim about the assembly itself. Only for
         net10.0: netstandard2.0 predates both attributes and has no such analyzer. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Analyzers, all dev-only: PrivateAssets="all" keeps every one of them out
         of the produced package, so a consumer never inherits them. Their
         findings and the rules currently deferred are documented in the NoWarn
         blocks further down. -->
    <PackageReference Include="AsyncFixer" Version="2.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Computes Version, AssemblyVersion, FileVersion and InformationalVersion
         from git history and tags. Build-time only: PrivateAssets="all" keeps it
         out of the produced package's dependencies. Configured by GitVersion.yml
         at the repository root. Replaces the hardcoded Version.props. -->
    <PackageReference Include="GitVersion.MsBuild" Version="6.*" PrivateAssets="all" />
    <PackageReference Include="IDisposableAnalyzers" Version="4.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pinned to 10.5.0.109200 deliberately: it is the last release under
         LGPL-3.0-only. From 10.6.0.109712 the package moved to the SONAR
         Source-Available License, which is not OSI-approved and whose grant
         excludes "employing, using, or engaging artificial intelligence
         technology ... to ingest, interpret, analyze ... or interact with the
         data provided by the Program" - that is, AI-assisted triage of its own
         findings, which is how this repository works. Being open source does not
         change that; the licence has no such carve-out. The pin costs almost
         nothing: 10.33 reports 93 findings here against 10.5's 90. -->
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.5.0.109200">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>


  <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <PackageReference Include="Microsoft.CSharp" Version="4.*" />
    <!-- netstandard2.0's own surface has no System.Reflection.Emit; net10.0
         carries it in-box. EmitCallSiteFuncType in
         Internal/Optimization/InvokeHelper-Regular.cs needs
         AssemblyBuilder/ModuleBuilder/TypeBuilder to build the >14-argument
         call site delegate type itself (issue #27). Conditioned to
         netstandard2.0 only so net10.0 consumers get no extra dependency;
         version matches the one ImpromptuInterface itself references for the
         same netstandard2.0 gap. -->
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
  </ItemGroup>


  <ItemGroup>
    <!-- Ships the repository root README as the NuGet listing page (#6). Pack="true"
         puts it in the package; PackagePath places it at the package root, matching
         PackageReadmeFile above. Visible="false" keeps it out of the Solution Explorer
         "Dynamitey" project node, since the file physically lives one level up. -->
    <None Include="..\Readme.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="InlineLambdas.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>InlineLambdas.cs</LastGenOutput>
    </None>
    <None Update="Internal\Optimization\InvokeHelper.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>InvokeHelper.cs</LastGenOutput>
    </None>
    <None Update="ThisFunctions.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>ThisFunctions.cs</LastGenOutput>
    </None>
  </ItemGroup>


  <ItemGroup>
    <Compile Update="InlineLambdas.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>InlineLambdas.tt</DependentUpon>
    </Compile>
    <Compile Update="Internal\Optimization\InvokeHelper.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>InvokeHelper.tt</DependentUpon>
    </Compile>
    <Compile Update="ThisFunctions.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ThisFunctions.tt</DependentUpon>
    </Compile>
  </ItemGroup>


  <ItemGroup>
    <!-- The declared public API surface, one entry per public member, read by
         Microsoft.CodeAnalysis.PublicApiAnalyzers. Any change to the surface
         fails the build until the change is written into these files, which
         makes an accidental breaking change impossible to merge quietly.

         Shipped holds the surface of the last release; Unshipped holds what
         has been added since. This fork has not released yet, so Shipped is
         empty apart from its nullable directive and the entire surface sits in
         Unshipped. At 4.0.0 the Unshipped entries move across, and from then on
         the split carries its usual meaning. -->
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Every built-in .NET analyzer rule, not just the default subset. Scoped
         to this project rather than set in Directory.Build.props because the
         test and benchmark projects are not the shipped product: rules like
         CA1707 (no underscores in names) and CA1515 (make types internal) are
         signal here and noise in a test fixture. Solution-wide this setting
         reports 566 findings; scoped to the library it reports 218. -->
    <AnalysisMode>All</AnalysisMode>

    <!-- THE BACKLOG. Every rule below currently fires on this twelve-year-old
         codebase, and each is silenced only until it has been triaged. This
         list is meant to shrink: a batch of work removes one or more entries,
         fixing the real defects and suppressing the deliberate design choices
         at the call site with a written reason - the same standard used for the
         dismissed CodeQL alerts.

         It is written here, rather than left as tolerated warnings, so the
         -warnaserror gate in CI stays on the whole time. A new violation of a
         rule NOT on this list fails the build immediately, which is the point:
         the backlog is fixed at what already existed and cannot grow.

         Counts are unique (file, line, rule) at the time of writing.

         Likely mostly deliberate design, expected to end as suppressions:
           CA1000 (36) static members on generic types - this is the library's
                       core pattern (BinderHash<T>.Create, InvokeHelper<T>)
           CA1034 (8)  nested public types - InvokeContext, Builder and friends
           CA1040 (2)  empty interfaces - marker interfaces
           CA1724 (3)  type name conflicts with a namespace
           CA1716 (7)  identifier matches a language keyword

         Likely real, expected to end as fixes:
           CA1062 (72) public methods do not validate arguments for null
           CA1825 (15) allocating an empty array instead of Array.Empty<T>()
           CA1852 (27) internal types that can be sealed
           CA1861 (35) constant arrays passed as arguments, reallocated per call
           CA1860 (8)  Any() where Count/Length is cheaper
           CA1851 (3)  multiple enumerations of an IEnumerable
           CA1859 (4)  use concrete types where possible for performance
           CA1810 (3)  static field initialization in an explicit static ctor
           CA1812 (11) internal classes that are apparently never instantiated
           CA2201 (4)  raising reserved exception types
           CA2208 (1)  argument exception constructed without the argument name
           CA1508 (2)  dead conditional code

         Needs a judgement call on public API, which #3 will revisit anyway:
           CA1051 (12) visible instance fields
           CA2225 (12) operator overloads without named alternatives
           CA2227 (1)  collection properties with a public setter
           CA1002 (4)  List<T> on a public surface
           CA1710 (2), CA1711 (5), CA1720 (4), CA1707 (44), CA1725 (1),
           CA1019 (2), CA1024 (2), CA1032 (1), CA1033 (1), CA1065 (11),
           CA1822 (56), CA1305 (24), CA1307 (4), CA1819 (3), CA1031 (4)
    -->
    <NoWarn>$(NoWarn);CA1000;CA1002;CA1019;CA1024;CA1031;CA1032;CA1033;CA1034;CA1040;CA1051;CA1062;CA1065;CA1305;CA1307;CA1707;CA1710;CA1711;CA1716;CA1720;CA1724;CA1725;CA1810;CA1812;CA1819;CA1822;CA1825;CA1851;CA1852;CA1859;CA1860;CA1861;CA2201;CA2208;CA2225;CA2227;CA1508</NoWarn>

    <!-- Sonar's share of the backlog: 90 findings across 31 rules, on the same
         terms as the CA list above. Its signal is different in kind - it found
         the swapped NewItems/OldItems in List's Replace notification (#59),
         which the test suite, CodeQL and the CA rules had all passed over.

         Real defects, expected to end as fixes:
           S1481 (8)  unused local variables
           S125  (5)  commented-out code
           S112  (4)  System.Exception thrown directly
           S2094 (3)  empty classes
           S1854 (2)  dead stores
           S1144 (1)  unused private method
           S2372 (1)  property getter that throws
           S1871 (1)  two switch arms with identical bodies
         Overlaps something already known:
           S2743 (12) static field in a generic type - the same design CA1000
                      flags 36 times, seen by a second tool, not 12 new problems
           S3897 (6) / S4035 (5) IEquatable<T> on the types #52 just settled
         Style or preference:
           S4136 (11) overloads not adjacent, S6608 (6) indexer over ElementAt,
           and singletons of S101, S907, S927, S1133, S2219, S2223, S2325, S2328,
           S3011, S3218, S3247, S3260, S3265, S3267, S3963, S4019, S4050

         S2234 is listed only until #60 merges. It has exactly one instance - the
         Replace transposition at List.cs:326 - and that PR fixes it. Remove this
         entry then, so the rule that caught a real bug is live again. -->
    <NoWarn>$(NoWarn);S101;S112;S125;S907;S927;S1133;S1144;S1481;S1854;S1871;S2094;S2219;S2223;S2234;S2325;S2328;S2372;S2743;S3011;S3218;S3247;S3260;S3265;S3267;S3897;S3963;S4019;S4035;S4050;S4136;S6608</NoWarn>

  </PropertyGroup>
</Project>