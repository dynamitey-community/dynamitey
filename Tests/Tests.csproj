<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- ImpromptuInterface is needed at RUNTIME only: Dynamic.CoerceConvert late-binds
         to Impromptu.DynamicActLike to duck-type a value into an interface, so without
         the package on disk that path cannot resolve.

         It carries a compile-time reference to the ORIGINAL Dynamitey 3.0.3 from
         nuget.org, which since #3 is a different assembly identity from this fork.
         Both would then contribute the same type names and every shared type becomes
         CS0433 ambiguous. Aliasing the transitive assembly takes it out of the global
         namespace, so this project's own types resolve unambiguously while the package
         stays on disk for the late-bound call to find. -->
    <PackageReference Include="ImpromptuInterface" Version="8.0.*" />
    <!-- Declared directly, and only so the alias applies: Aliases is honored on a direct
         PackageReference but ignored on a transitive one. This is test-only (IsPackable is
         false), so nothing here reaches the produced package. -->
    <PackageReference Include="Dynamitey" Version="3.0.3" Aliases="upstream" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit.Console" Version="3.22.0" />
    <PackageReference Include="IronPython" Version="3.4.2" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <!-- Runtime-compiles a throwaway assembly in TestRoslynLateTypeBind, the
         Roslyn replacement for the CodeDom-based late-bind coverage removed
         under #23 item 3. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />

  </ItemGroup>

 
  <ItemGroup>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dynamitey\Dynamitey.csproj" />
    <ProjectReference Include="..\SupportLibrary\SupportLibrary.csproj" />
  </ItemGroup>
</Project>
